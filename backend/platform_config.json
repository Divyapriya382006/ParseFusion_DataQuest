{
  "poll_interval_ms": 2000,
  "auth": {
    "mode": "none"
  },
  "processing_modes": [
    {
      "id": "auto",
      "label": "Automatic routing",
      "description": "The format router picks native text, OCR or spreadsheet extraction for each page."
    }
  ],
  "action_types": [],
  "confidence_bands": [
    {
      "id": "high",
      "min": 0.85,
      "max": 1.0,
      "label": "High"
    },
    {
      "id": "medium",
      "min": 0.6,
      "max": 0.85,
      "label": "Medium"
    },
    {
      "id": "low",
      "min": 0.0,
      "max": 0.6,
      "label": "Low"
    }
  ],
  "severity_levels": [
    {
      "id": "high",
      "label": "High"
    },
    {
      "id": "medium",
      "label": "Medium"
    },
    {
      "id": "low",
      "label": "Low"
    }
  ],
  "feature_flags": {},
  "consensus": {
    "ocr_cross_check": true,
    "native_weight": 0.6,
    "agreement_weight": 0.4,
    "agreement_review_below": 0.8,
    "ocr_only_min_confidence": 0.4,
    "min_figure_area": 0.01,
    "max_cross_check_pages": 200,
    "max_region_rechecks_per_page": 60
  },
  "doc_types": {
    "salary certificate / payslip": [
      "salary certificate",
      "payslip",
      "pay slip",
      "employee name",
      "pay period",
      "net salary",
      "gross salary"
    ],
    "bank statement": [
      "bank statement",
      "account holder",
      "statement period",
      "closing balance",
      "opening balance",
      "account number"
    ],
    "invoice": [
      "invoice",
      "invoice number",
      "bill to",
      "gstin",
      "amount due",
      "tax invoice"
    ],
    "loan / credit application": [
      "loan application",
      "applicant",
      "loan amount",
      "tenure",
      "borrower"
    ],
    "income certificate": [
      "income certificate",
      "annual income",
      "issued by"
    ],
    "financial statements": [
      "balance sheet",
      "profit and loss",
      "revenue",
      "ebitda",
      "total assets"
    ],
    "term sheet": [
      "term sheet",
      "valuation",
      "investment amount",
      "liquidation preference"
    ],
    "lecture slides / technical notes": [
      "algorithm",
      "complexity",
      "lecture",
      "theorem",
      "proof",
      "graph",
      "vertices"
    ]
  },
  "parse_score": {
    "caps": {
      "UNUSABLE_TEXT_LAYER": 0.5,
      "OCR_FAILED": 0.7,
      "CONFIDENCE_NOT_CROSS_CHECKED": 0.85,
      "OCR_UNAVAILABLE": 0.85,
      "PAGES_UNREAD": 0.5
    }
  },
  "agents": {
    "reasoning": {
      "tolerance_abs": 0.01,
      "tolerance_pct": 1.0,
      "rounding_pct": 0.5,
      "severity_thresholds": [
        {
          "severity": "high",
          "min_pct": 10
        },
        {
          "severity": "medium",
          "min_pct": 2
        }
      ],
      "default_severity": "low",
      "max_facts": 5000,
      "max_pairs_per_group": 200,
      "confidence_penalties": {
        "ambiguity": 0.1,
        "weak_check": 0.05
      },
      "notify_severities": [
        "high"
      ],
      "required_capability": "cases:review",
      "excerpt_max_chars": 300,
      "label_max_chars": 120
    },
    "fact_normalizer": {
      "required_capability": "cases:review",
      "include_unverified_links": false
    }
  },
  "page_quality": {
    "ink_grid_columns": 48,
    "ink_gray_threshold": 160,
    "ink_min_cell_fraction": 0.004,
    "coverage_partial_below": 0.6,
    "uncovered_min_cells": 4,
    "equation_math_chars": "=+−-×÷*/^<>≤≥≠≈∑∏∫√∞∂∇αβγδεθλμπσφωΔΣΠΩ()[]{},",
    "equation_operator_chars": "=+−×÷^<>≤≥≠≈∑∏∫√∂∇",
    "equation_fragment_max_chars": 3,
    "equation_min_math_ratio": 0.4,
    "equation_prose_min_words": 3,
    "equation_formula_max_words": 14,
    "equation_line_gap_factor": 0.8,
    "equation_x_gap_factor": 6.0,
    "table_min_rows": 2,
    "table_min_cols": 2,
    "table_min_fill": 0.5,
    "table_min_row_consistency": 0.6,
    "table_max_words_per_cell": 12,
    "chart_min_axis_fraction": 0.15,
    "chart_corner_tolerance_pt": 6.0,
    "chart_min_marks": 3,
    "chart_label_margin_fraction": 0.12,
    "caption_max_gap_fraction": 0.06,
    "caption_pattern": "^\\s*(fig(ure)?|chart|graph|diagram|image|plate|plot)\\.?\\s*\\d+"
  },
  "ui": {
    "batch_page_size": 10,
    "block_render_chunk": 40,
    "shred_max_chars": 2,
    "shred_min_run": 3
  }
}
